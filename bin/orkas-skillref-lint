#!/usr/bin/env python3
"""Thin launcher for orkas-skillref-lint (keeps the CLI import-free)."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from orkas_skillref_lint import main  # type: ignore  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())